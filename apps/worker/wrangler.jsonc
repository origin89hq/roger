{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roger",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roger",
      "database_id": "bbbc1e04-91fd-4323-a98a-e2085594d48a",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "roger.origin89.com", "custom_domain": true }],
  // The inbox page and its script. API and sign-in routes run the Worker first.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/auth/*"]
  },
  // `roger login` starts per client IP. Without this binding the Worker
  // refuses every login. Machines behind one NAT share the limit.
  "ratelimits": [
    {
      "name": "DEVICE_LOGINS",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Expiry, delayed pushes, the morning digest, and retention.
  "triggers": { "crons": ["*/5 * * * *"] },
  // GITHUB_CLIENT_SECRET and NTFY_TOKEN are Worker secrets. Each responder sets
  // their own ntfy topic in the inbox; an empty NTFY_URL disables pushes.
  "secrets": { "required": ["GITHUB_CLIENT_SECRET"] },
  "vars": {
    "APP_ORIGIN": "https://roger.origin89.com",
    "GITHUB_CLIENT_ID": "Ov23lia6LxrKPfmJRf5R",
    "GITHUB_ORG": "origin89hq",
    "GITHUB_TEAM": "working-group",
    "NTFY_URL": "https://ntfy.sh",
    "TIME_ZONE": "America/Toronto",
    "WORK_DAYS": "mon-fri",
    "WORK_HOURS": "08:00-18:00"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
